<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <application android:label="Wallpaper Monet 伴侣" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".ExportReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter><action android:name="com.wallpapermonet.companion.EXPORT" /></intent-filter>
        </receiver>
    </application>
</manifest>
